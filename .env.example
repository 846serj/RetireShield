# Copy to .env.local and fill in. The app RUNS WITHOUT these (leads log to console),
# but set Supabase to actually persist leads.

# Copy to .env.local and fill in. The free-Score flow runs with NONE of these.
# Auth + billing (Phase 3-6) need the Supabase + Stripe values.

NEXT_PUBLIC_BASE_URL=https://retireguard.onrender.com

# --- Supabase (auth + data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Phase 4) — use TEST keys until lawyer sign-off (Phase 6) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_MONTHLY=
STRIPE_WEBHOOK_SECRET=
# Set false only when Stripe Tax is unavailable. Defaults to true for the Benefits Checklist.
BENEFITS_CHECKLIST_STRIPE_TAX_ENABLED=true
BENEFITS_CHECKLIST_STORAGE_BUCKET=retire-shield-products
# Keep false until all three paid files are present in the private bucket.
BENEFITS_CHECKLIST_DOWNLOADS_READY=false
# Keep false until all 51 private State Pack files pass a test order.
BENEFITS_CHECKLIST_STATE_PACKS_READY=false
# Keep false until the intake migration, email, and a test report order pass.
BENEFITS_REPORT_INTAKE_READY=false
BENEFITS_REPORT_NOTIFY_EMAIL=

# --- Email / ESP (Phase 7) ---
ESP_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Analytics (Phase 8) ---
NEXT_PUBLIC_POSTHOG_KEY=
